# Nothing in this file is required. A new install is set up in the browser
# (setup code, Claude key, your Gmail) and makes its own secrets in its data
# folder. Set anything here, or in the container's environment, to override
# that: environment values always win. docs/self-hosting.md explains each.

# --- Where everything is kept ----------------------------------------------------
# Accounts, ledgers, settings made in the app, and the secrets below if they
# aren't set here. /data in the container.
DATA_DIR=data
# Set by scripts/deploy-cloud-run.sh: the data folder is a mounted storage
# bucket, so Cloud Run's restarts don't wipe it.
PERSISTENT_DATA_DIR=false

# --- How the app reads Gmail -----------------------------------------------------
# app-password = Gmail over IMAP with an app password each person makes (no
#                Google Cloud project; ledgers in DATA_DIR/ledgers).
# google       = Google sign-in: read-only Gmail and a file in each person's
#                Drive. Needs the OAuth client below (npm run setup:google).
# Unset: google when GOOGLE_CLIENT_ID is set, otherwise app-password.
MAIL_ACCESS=app-password

# --- Who may sign in -------------------------------------------------------------
# App-password installs: the owner invites people in the app; anyone listed
# here may also join without an invite. Google sign-in: required, and only
# these accounts may sign in.
ALLOWED_EMAILS=

# --- First run -------------------------------------------------------------------
# The one-time code the first-run screen asks for. Unset: made on first start
# and printed in the log ("enter this setup code").
SETUP_CODE=

# --- Google OAuth (MAIL_ACCESS=google only: your own Web application client) ----
# console.cloud.google.com > Google Auth Platform > Clients.
# Scopes requested: openid, email, profile, gmail.readonly, drive.file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/login/callback

# --- Claude ----------------------------------------------------------------------
# anthropic = Anthropic's own API: one key, nothing else to set up.
# bedrock   = Claude on Amazon Bedrock: AWS runs inference with no operator
#             access and doesn't store prompts. Needs the AWS values below.
# The welcome screens (and the privacy page, if on) name whichever is set.
AI_PROVIDER=anthropic
# console.anthropic.com > API keys. Usually entered on the first-run screen
# instead; set here, it can't be changed in the app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Secrets (made on first start and kept in DATA_DIR/secrets.json) ---------------
# Only set these to manage them yourself, e.g. in Secret Manager on Cloud Run.
# Signs session cookies. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Encrypts every saved app password, refresh token, statement password and the
# Claude key. 32 bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or rotating it stops background syncing until everyone signs in again.
TOKEN_ENCRYPTION_KEY=
# Shared secret for POST /api/cron/poll, which Cloud Scheduler calls with it as
# X-Cron-Key.
CRON_SECRET=

# ============================================================================
# OPTIONAL
# ============================================================================

# --- Where accounts are stored -------------------------------------------------------
# file = DATA_DIR/users.json; firestore = Cloud Run without a mounted bucket.
USER_STORE=file
FIRESTORE_COLLECTION=accounts

# --- Checking email --------------------------------------------------------------------
# Check every account's email this often (minutes), inside the server. 0 = off,
# as on Cloud Run, where Cloud Scheduler calls /api/cron/poll instead. Opening
# the app checks too, and any check catches up on time the server was off.
POLL_INTERVAL_MINUTES=10
# New emails one check reads at most; the rest wait for the next one.
POLL_BATCH_SIZE=60
POLL_LOOKBACK_HOURS=24
POLL_CONCURRENCY=4

# --- Behaviour -------------------------------------------------------------------------
PRODUCT_NAME=Expense Tracker
# The ledger file created in each person's Drive. If you also run another copy
# of this app with the same Google account, give each copy its own name.
DRIVE_FILE_NAME=expenses-app-ledger.json
# Dates are stamped in this timezone.
APP_TIMEZONE=Asia/Kolkata
PIN_IDLE_MINUTES=15
# Hides the "Google hasn't verified this app" step before sign-in. Leave false
# for a personal install: your own OAuth app is unverified, and that's normal.
GOOGLE_APP_VERIFIED=false
# Extra senders to search for statement PDFs, beyond statement-like subjects.
UPI_STATEMENT_SENDER=fedmail@federal.bank.in,noreply@jupiter.money
# Never import statement rows dated before this (YYYY-MM-DD).
UPI_STATEMENT_SINCE=
MAX_CACHED_ACCOUNTS=200
PORT=8080

# --- Claude on Amazon Bedrock (only when AI_PROVIDER=bedrock) ---------------------------
# Credentials come from the standard AWS chain: an IAM user or role limited to
# bedrock-mantle:CreateInference on the model.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=anthropic.claude-haiku-4-5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# RUNNING IT AS A PUBLIC SERVICE (all off for a self-hosted install)
# docs/hosted-mode.md explains each.
# ============================================================================

# Let anyone with a Google account sign up instead of ALLOWED_EMAILS.
OPEN_SIGNUP=false
# Refuse new accounts past this many (0 = no cap). An unverified Google app can
# only ever sign up 100 users in its lifetime.
MAX_USERS=0

# 14-day trial, then a paywall with Razorpay subscriptions.
BILLING_ENABLED=false
TRIAL_DAYS=14
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
RAZORPAY_MONTHLY_CYCLES=120
RAZORPAY_YEARLY_CYCLES=10

# Share bank email formats across accounts once enough learn the same one.
SHARED_TEMPLATES_ENABLED=false
TEMPLATE_LIBRARY_MIN_ACCOUNTS=3
TEMPLATE_LIBRARY_FILE=data/template-library.json
TEMPLATE_LIBRARY_COLLECTION=templateLibrary

# /privacy and /terms (drafts in server/legal/), and the consent line at sign-in.
LEGAL_PAGES_ENABLED=false
SUPPORT_EMAIL=
OPERATOR_NAME=
POLICY_EFFECTIVE_DATE=
# Recorded on each account at sign-up. Bump it when the privacy policy changes.
POLICY_VERSION=2026-09-draft
